{
    "tasks": [
        {
            "type": "cppbuild",
            "label": "C/C++: clang++ build active folder",
            "command": "/usr/bin/clang++",
            "args": [
                "-std=c++20",
                "-Wall",
                "-Wextra",
                "-Werror",
                "-fcolor-diagnostics",
                "-fansi-escape-codes",
                "-g",
                "-pedantic-errors",
                "${file}",
                "./networking/**/*.cpp",
                "-o",
                "${fileDirname}/output/program"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "Task generated by Debugger."
        },
    ],
    "version": "2.0.0"
}
